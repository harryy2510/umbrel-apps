# Copy to stack.env next to this file (Umbrel app-data) or pass:
#   docker compose --env-file stack.env up -d
# Never name this file .env
#
# Fill from the live Arcane containers. Do not generate new secrets if you are
# copying volumes; new BETTER_AUTH_SECRET / POSTGRES_PASSWORD /
# OOMOL_CONNECT_ENCRYPTION_KEY break sessions, Postgres, and OAuth data.
#
# MetaMCP:
#   docker exec arcane_docker_1 docker -H unix:///data/docker.sock exec metamcp printenv
# OpenConnector:
#   docker exec arcane_docker_1 docker -H unix:///data/docker.sock exec open-connector-connector-1 printenv
# CloudWatch wrappers (if they already exist):
#   docker exec arcane_docker_1 docker -H unix:///data/docker.sock exec metamcp-cw-dev printenv
#   docker exec arcane_docker_1 docker -H unix:///data/docker.sock exec metamcp-cw-prod printenv
#
# Quote any value that contains $, spaces, or #. exports.sh sources this file.

APP_URL=http://umbrel.local:12008

POSTGRES_USER=metamcp_user
POSTGRES_DB=metamcp_db
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://metamcp_user:PASTE_SAME_PASSWORD@127.0.0.1:9433/metamcp_db

BETTER_AUTH_SECRET=

# Migrating an existing Postgres volume: leave false.
# Fresh empty data dir only: true, and set the bootstrap user fields.
BOOTSTRAP_ENABLE=false
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_NAME=Admin
BOOTSTRAP_USER_PASSWORD=

OOMOL_CONNECT_ORIGIN=http://umbrel.local:33000
OOMOL_CONNECT_ENCRYPTION_KEY=
OOMOL_CONNECT_ADMIN_TOKEN=

# Do not put Oomol runtime tokens (oct_…) here. Those belong on MetaMCP
# MCP-server rows (bearer_token), never in agentsync.

CW_DEV_AWS_ACCESS_KEY_ID=
CW_DEV_AWS_SECRET_ACCESS_KEY=
CW_DEV_AWS_REGION=us-east-1
CW_PROD_AWS_ACCESS_KEY_ID=
CW_PROD_AWS_SECRET_ACCESS_KEY=
CW_PROD_AWS_REGION=us-east-1
