#!/usr/bin/env bash
set -euo pipefail

APP_DATA_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"

if [ ! -f "${APP_DATA_DIR}/stack.env" ]; then
  echo "hariom-mcp: missing ${APP_DATA_DIR}/stack.env" >&2
  echo "Copy env.example to stack.env and fill from the live Arcane printenv dumps." >&2
  echo "Do not invent BETTER_AUTH_SECRET, POSTGRES_PASSWORD, or OOMOL_CONNECT_ENCRYPTION_KEY when migrating volumes." >&2
  exit 1
fi

mkdir -p \
  "${APP_DATA_DIR}/data/postgres" \
  "${APP_DATA_DIR}/data/oomol" \
  "${APP_DATA_DIR}/data/uv-cache"
