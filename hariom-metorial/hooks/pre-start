#!/usr/bin/env bash
set -euo pipefail

# Seed dashboard + Caddyfile on first start. Umbrel APP_DATA_DIR is empty.
APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${APP_DATA_DIR}/data"

mkdir -p "${DEST}/dashboard" "${DEST}/postgres" "${DEST}/redis" "${DEST}/mongo" \
  "${DEST}/meili" "${DEST}/minio" "${DEST}/etcd" "${DEST}/opensearch"

# Dashboard + Caddyfile are bind-mounted from the app package (./data/...),
# not APP_DATA_DIR. Do not copy them here or updates never appear.
