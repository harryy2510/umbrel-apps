#!/usr/bin/env bash
set -euo pipefail

# Seed dashboard + Caddyfile on first start. Umbrel APP_DATA_DIR is empty.
APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${APP_DATA_DIR}/data"

mkdir -p "${DEST}/dashboard" "${DEST}/postgres" "${DEST}/redis" "${DEST}/mongo" \
  "${DEST}/meili" "${DEST}/minio" "${DEST}/etcd" "${DEST}/opensearch"

cp "${APP_ROOT}/data/Caddyfile" "${DEST}/Caddyfile"

# Refresh packaged SPA unless the operator pinned a custom build.
if [ ! -f "${DEST}/dashboard/.keep-custom" ]; then
  rm -rf "${DEST}/dashboard"
  cp -a "${APP_ROOT}/data/dashboard" "${DEST}/dashboard"
fi
